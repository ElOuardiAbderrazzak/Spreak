    "espeak-ng": "^1.0.2",
    "hyphen": "^1.14.1",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
